# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Ephemeral output of integration_test/screenshot_test.dart, the curated,
# submission-ready copies live in /screenshots/app_store and
# /screenshots/play_store instead (see test_driver/integration_test.dart).
/screenshots/raw/

# tool/store_creative/make_creative.py's `preview` mode: quick-look stills
# for local iteration, not the real deliverables. Even written into
# screenshots/store/app_store/creative/ (its default --out, same as
# `video` mode) these never get committed; the real header_*/search_*
# .mp4/.png pairs from `video` mode aren't matched by this and do.
screenshots/store/app_store/creative/*_preview.png
screenshots/store/app_store/creative/*_preview_fade.png
