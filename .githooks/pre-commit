#!/usr/bin/env bash
# Installed via scripts/setup_git_hooks.sh (git config core.hooksPath .githooks).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

if ! command -v flutter >/dev/null 2>&1; then
  echo "pre-commit: 'flutter' not found on PATH. Install Flutter, or run 'git commit --no-verify' to skip this check." >&2
  exit 1
fi

echo "pre-commit: checking formatting..."
if ! dart format --output=none --set-exit-if-changed .; then
  echo "pre-commit: formatting issues found. Run 'dart format .' and re-commit." >&2
  exit 1
fi

echo "pre-commit: running flutter analyze..."
flutter analyze

echo "pre-commit: offline-only URL scan..."
./scripts/check_no_network_urls.sh
